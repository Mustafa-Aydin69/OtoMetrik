{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "WebSite/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "predict_api", "format": "url", "env": "PREDICTION_API_URL" }
      ]
    },
    "predict_api": {
      "root": "WebScrape/ai-model/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
